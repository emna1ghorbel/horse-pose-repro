# Retirés ensuite : plusieurs chevaux visibles dans le cadre (troupeau, paire,
# course, vente aux enchères) -- le pipeline suppose un seul squelette par
# image, un second cheval dans le cadre risque de fausser les keypoints.
MULTI_HORSE_IDS = {
    "ugt-Oj-YdbQ", "giOAkmR8gP8", "teK3eSC8OhE", "ig0ANQrp5aI", "AToJugUWtXI",
    "FLqE861USwk", "hWSFZJeAKwg", "hHGTMlh6ar8", "vYSMPmJkW5Q", "djnXPZYTz9Y",
