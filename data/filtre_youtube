KEEP_IDS -= MULTI_HORSE_IDS

ID_RE = re.compile(r"watch\?v=([A-Za-z0-9_-]{11})")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--input", default="candidates_shorts.txt")
    parser.add_argument("--output", default="candidates_shorts_reviewed.txt")
    args = parser.parse_args()

    kept_lines, dropped = 0, 0
    with open(args.input, "r", encoding="utf-8") as f_in, \
         open(args.output, "w", encoding="utf-8") as f_out:
        for line in f_in:
            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                continue
            match = ID_RE.search(stripped)
            if match and match.group(1) in KEEP_IDS:
                f_out.write(line)
                kept_lines += 1
            else:
                dropped += 1

    print(f"{kept_lines} vidéos gardées -> {args.output}")
    print(f"{dropped} vidéos écartées")


if __name__ == "__main__":
    main()