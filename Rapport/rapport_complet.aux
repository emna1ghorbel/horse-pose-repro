\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Meilleur résultat --- Seed 70 (score : 0.439).} Le squelette est fidèlement ancré sur la silhouette du cheval dans la majorité des images. La heatmap Phi montre une localisation précise du corps. Les membres avant (bleu/violet) et arrière (orange/jaune) sont correctement positionnés. }}{17}{figure.caption.19}\protected@file@percent }
\newlabel{fig:seed70}{{2}{17}{\textbf {Meilleur résultat --- Seed 70 (score : 0.439).} Le squelette est fidèlement ancré sur la silhouette du cheval dans la majorité des images. La heatmap Phi montre une localisation précise du corps. Les membres avant (bleu/violet) et arrière (orange/jaune) sont correctement positionnés}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Résultat robuste --- Seed 10 (score : 0.437).} Bonne robustesse malgré la grande diversité des poses (galop, trot, arrêt). Quelques cas limites avec le cheval en vue de face montrent une légère ambiguïté gauche/droite. }}{17}{figure.caption.20}\protected@file@percent }
\newlabel{fig:seed10}{{3}{17}{\textbf {Résultat robuste --- Seed 10 (score : 0.437).} Bonne robustesse malgré la grande diversité des poses (galop, trot, arrêt). Quelques cas limites avec le cheval en vue de face montrent une légère ambiguïté gauche/droite}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Correction d'échelle --- Seed 30 (score : 0.428).} Ce lot présente davantage de chevaux en plan large. L'algorithme d'alignement BBox corrige efficacement le biais d'échelle d'Omega, qui produirait sinon un squelette trop petit concentré au centre. }}{18}{figure.caption.21}\protected@file@percent }
\newlabel{fig:seed30}{{4}{18}{\textbf {Correction d'échelle --- Seed 30 (score : 0.428).} Ce lot présente davantage de chevaux en plan large. L'algorithme d'alignement BBox corrige efficacement le biais d'échelle d'Omega, qui produirait sinon un squelette trop petit concentré au centre}{figure.caption.21}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}Évaluation PCK --- Heatmap vs Masque silhouette}{18}{subsection.8.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Évaluation PCK sur 10 images représentatives.} Ligne 1 : image d'entrée. Ligne 2 : masque GT de silhouette (vert). Ligne 3 : heatmap Phi brute (colormap hot), avec l'IoU et la couverture indiqués. Ligne 4 : overlay superposant heatmap (rouge) et masque GT (vert). Métriques agrégées : IoU=0.256, Coverage=0.832, Precision=0.281. }}{18}{figure.caption.22}\protected@file@percent }
\newlabel{fig:pck}{{5}{18}{\textbf {Évaluation PCK sur 10 images représentatives.} Ligne 1 : image d'entrée. Ligne 2 : masque GT de silhouette (vert). Ligne 3 : heatmap Phi brute (colormap hot), avec l'IoU et la couverture indiqués. Ligne 4 : overlay superposant heatmap (rouge) et masque GT (vert). Métriques agrégées : IoU=0.256, Coverage=0.832, Precision=0.281}{figure.caption.22}{}}
